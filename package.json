{
  "name": "b-send-dan",
  "version": "1.0.0",
  "description": "bilibili 弹幕自动发送(油猴脚本)",
  "keywords": [
    "bilibili"
  ],
  "license": "MIT",
  "author": "jiejiebiezheyang",
  "type": "module",
  "main": "./dist/output/main.js",
  "scripts": {
    "start": "node dist/output/main.js",
    "build": "tsc",
    "watch": "tsc --watch",
    "obfuscate": "tsc && javascript-obfuscator dist/output --output dist --config ./obfuscate.config.json",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "devDependencies": {
    "javascript-obfuscator": "^5.8.0",
    "typescript": "^6.0.3"
  }
}